# Copia este fichero a .env.local y rellena tus valores.
# NUNCA subas .env.local al repo.

# URL del backend del juego. '.' = mismo origen (el servidor del juego hace de proxy)
VICE_BACKEND_URL=.
VICE_BACKEND_KEY=cambia-esta-clave-publica

# backend
BACKEND_PORT=8787
BACKEND_PUBLIC_KEY=cambia-esta-clave-publica
